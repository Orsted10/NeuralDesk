{
  "name": "aetheria-desktop",
  "version": "1.2.0",
  "description": "AetheriaCompute — Ambient AI Desktop Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder build --win",
    "build:mac": "electron-builder build --mac",
    "build:linux": "electron-builder build --linux"
  },
  "keywords": [],
  "author": "AetheriaCompute",
  "repository": "https://github.com/Orsted10/NeuralDesk",
  "license": "ISC",
  "build": {
    "appId": "me.aetheriacompute.app",
    "productName": "AetheriaCompute",
    "copyright": "Copyright © 2025 AetheriaCompute",
    "compression": "store",
    "publish": {
      "provider": "github",
      "owner": "Orsted10",
      "repo": "NeuralDesk"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AetheriaCompute"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "memory_db.js",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "app.asar.unpacked/bin/"
      }
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "electron-updater": "^6.8.9",
    "qrcode-terminal": "^0.12.0",
    "sqlite3": "^6.0.1",
    "whatsapp-web.js": "^1.34.7"
  }
}
